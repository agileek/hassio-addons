{
  "arch": ["aarch64", "amd64"],
  "boot": "auto",
  "description": "Addon for wrapping signal inside docker",
  "devices": ["/dev/urandom"],
  "map": ["config:rw"],
  "name": "Signal",
  "homeassistant_api": true,
  "hassio_api": true,
  "hassio_role": "homeassistant",
  "options": {
    "phone_number": "+0102030405",
    "signal_config_path": "/config/.signal",
    "log_level": "DEBUG",
    "allowed_senders": []
  },
  "schema": {
    "phone_number": "str",
    "signal_config_path": "str",
    "log_level": "str",
    "allowed_senders": [
      "match(^\\+[1-9][0-9]{6,14}$)"
    ]
  },
  "slug": "signal",
  "startup": "services",
  "version": "13.5.0",
  "init": false,
  "image": "agileek/hassio-{arch}-signal"
}
